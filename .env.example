# ---------------------------------------------------------------------------
# Deepfake Detection Platform — example environment file
# Copy to .env and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- API ---
APP_NAME="Deepfake Detection Platform"
API_V1_PREFIX=/api
ENVIRONMENT=development           # development | production
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (docker-compose) ---
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=deepfake

# --- Database ---
# Dev default is SQLite so the project runs with zero infrastructure.
# Production (docker-compose) uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg://deepfake:deepfake@db:5432/deepfake
# Relative paths here are resolved against the working directory; the built-in
# default is an absolute path under the repository root.
DATABASE_URL=sqlite:///./storage/deepfake.db

# --- Queue (Celery + Redis) ---
# Leave CELERY_BROKER_URL empty to run inference inline (eager mode, no Redis).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage ---
STORAGE_DIR=./storage/uploads
EVIDENCE_DIR=./storage/evidence
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=100

# --- Rate limiting ---
UPLOAD_RATE_LIMIT_PER_HOUR=20
GUEST_RATE_LIMIT_PER_HOUR=3

# --- Models ---
CHECKPOINT_DIR=./checkpoints
IMAGE_MODEL_BACKBONE=efficientnet_b0     # efficientnet_b0 | efficientnet_b4 | xception
IMAGE_MODEL_VERSION=image-detector-v1.0.0
AUDIO_MODEL_VERSION=audio-lcnn-v1.0.0
VIDEO_MODEL_VERSION=video-frame-agg-v1.0.0
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_FRAMES=32
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_SECONDS=4.0
DEVICE=cpu                               # cpu | cuda

# --- Decision thresholds ---
FAKE_THRESHOLD=0.5
UNCERTAIN_BAND=0.15                      # scores within +/- this of the threshold => "Inconclusive"

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
